+  /**
+   * Conversation top-edge blur — sticky viewport chrome, not per-message filter.
+   * Stronger near the top border; mask fades blur → sharp down the band.
+   */
+  .chat-scroll-top-blur {
+    position: sticky;
+    top: 0;
+    z-index: 5;
+    height: 48px;
+    margin-bottom: -48px;
+    pointer-events: none;
+    backdrop-filter: blur(8px);
+    -webkit-backdrop-filter: blur(8px);
+    background: linear-gradient(
+      to bottom,
+      color-mix(in oklab, var(--color-canvas) 42%, transparent) 0%,
+      transparent 100%
+    );
+    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 18%, transparent 100%);
+    mask-image: linear-gradient(to bottom, #000 0%, #000 18%, transparent 100%);
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .chat-scroll-top-blur {
+      backdrop-filter: none;
+      -webkit-backdrop-filter: none;
+      background: linear-gradient(
+        to bottom,
+        color-mix(in oklab, var(--color-canvas) 28%, transparent) 0%,
+        transparent 100%
+      );
+    }
+  }
